# Server-only credentials for beta AI features. Keep them out of VITE_ variables.
DEEPGRAM_API_KEY=
INCEPTION_API_KEY=

# Connect Upstash Redis to the Vercel project for Production AI quotas.
# Use the REST URL and read/write token. KV_REST_API_URL and KV_REST_API_TOKEN
# also work as a pair if the integration supplies those names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connect a private Vercel Blob store for transcription uploads above 4 MB.
# A Vercel connection using OIDC sets BLOB_STORE_ID instead.
BLOB_READ_WRITE_TOKEN=

# Daily UTC request limits. 0 pauses the corresponding action.
AI_DAILY_REQUESTS_PER_USER=10
AI_DAILY_REQUESTS_TOTAL=100
AI_DAILY_UPLOADS_PER_USER=5
AI_DAILY_UPLOADS_TOTAL=50

# Optional public SEO settings. Set to your preferred production HTTPS origin.
# Vercel builds fall back to VERCEL_PROJECT_PRODUCTION_URL when VITE_SITE_URL is unset.
# VITE_SITE_URL=https://example.com
# VITE_GOOGLE_SITE_VERIFICATION=
