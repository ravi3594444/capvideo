# Server-only credentials for beta AI features. Keep them out of VITE_ variables.
DEEPGRAM_API_KEY=
INCEPTION_API_KEY=

# One-line service account JSON from the Firebase project in firebase-applet-config.json.
# Used by the API to verify Google sign-in and reserve AI usage in Firestore.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Connect a private Vercel Blob store for transcription uploads above 4 MB.
BLOB_READ_WRITE_TOKEN=

# Daily UTC request limits. 0 pauses the corresponding action.
AI_DAILY_REQUESTS_PER_USER=10
AI_DAILY_REQUESTS_TOTAL=100
AI_DAILY_UPLOADS_PER_USER=5
AI_DAILY_UPLOADS_TOTAL=50
