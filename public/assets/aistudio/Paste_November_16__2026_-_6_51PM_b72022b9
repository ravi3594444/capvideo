    var blob=new Blob(chunks,{type:"video/webm"});
    download(blob,"caption-lite.webm");
    $("exportStatus").textContent="Saved caption-lite.webm ("+(blob.size/1048576).toFixed(1)+" MB). WebM format, captions burned in"+(usedCleanAudio?", with the improved (cleaned-up) sound.":".");
  };
  exporting=true;
  $("exportProg").classList.remove("hidden"); $("exportProg").value=0;
  $("exportStatus").textContent="Recording… the clip is playing through once. Don't switch apps.";
  video.currentTime=trimStart;
  video.play().then(function(){ rec.start(250); requestAnimationFrame(drawFrame);
    var w=setInterval(function(){ if(video.currentTime>=trimEnd-0.1||video.ended){ clearInterval(w); if(rec.state!=="inactive") rec.stop(); } },250);
  }).catch(function(){ exporting=false; $("exportStatus").textContent="Couldn't start playback. Tap Play once, then try export again."; });
});

/* ---------- reference video style match (on-device frame sampling) ---------- */
var refVideo=$("refVideo");
function rgbHex(r,g,b){ function h(n){return n.toString(16).padStart(2,"0")} return "#"+h(r)+h(g)+h(b); }
function seekRef(t){
  return new Promise(function(res){
    function done(){ refVideo.removeEventListener("seeked",done); res(); }
    refVideo.addEventListener("seeked",done);
    try{ refVideo.currentTime=t; }catch(e){ res(); }
    setTimeout(res,1200);
  });
}
function analyseFrame(ctx2,w,h){
  // Caption-like pixels: bright or strongly saturated. Captions are usually the brightest, most saturated thing in their band.
  var bands={top:{n:0,cols:{}},mid:{n:0,cols:{}},bot:{n:0,cols:{}}};
  var img;
  try{ img=ctx2.getImageData(0,0,w,h).data; }catch(e){ return null; }
  for(var y=0;y<h;y+=3){
    var band=y<h*0.33?bands.top:(y>h*0.66?bands.bot:bands.mid);
    for(var x=0;x<w;x+=3){
      var i=(y*w+x)*4, r=img[i], g=img[i+1], b=img[i+2];
      var mx=Math.max(r,g,b), mn=Math.min(r,g,b);
      var bright=mx>185, sat=mx-mn>70 && mx>110;
      if(!bright && !sat) continue;
      // skip near-greys unless very bright (white captions count)
      if(!sat && !(mx>225 && mn>190)) continue;
      var key=(r>>5)+","+(g>>5)+","+(b>>5);
      band.cols[key]=band.cols[key]||{n:0,r:0,g:0,b:0};
      band.cols[key].n++; band.cols[key].r+=r; band.cols[key].g+=g; band.cols[key].b+=b;
      band.n++;
    }
  }
  return bands;
}
function topColour(band){
  var best=null;
  for(var k in band.cols){ var c=band.cols[k]; if(!best||c.n>best.n) best=c; }
  if(!best||best.n<12) return null;
  return {hex:rgbHex(Math.round(best.r/best.n),Math.round(best.g/best.n),Math.round(best.b/best.n)),n:best.n};
}
$("refInput").addEventListener("change",function(e){
  var f=e.target.files[0]; if(!f) return;
  if(refVideo.src) URL.revokeObjectURL(refVideo.src);
  refVideo.src=URL.createObjectURL(f);
  $("refStage").classList.remove("hidden");
  $("refResult").classList.add("hidden");
  $("refStatus").textContent="Reference loaded. Now tap “Read the reference style”.";
  refVideo.addEventListener("loadedmetadata",function(){ $("refAnalyseBtn").classList.remove("hidden"); },{once:true});
});
$("refAnalyseBtn").addEventListener("click",function(){
  if(!refVideo.src){ $("refStatus").textContent="Load a reference video first."; return; }
  $("refStatus").textContent="Sampling frames on your phone. Nothing is uploaded…";
  var wasPaused=refVideo.paused; refVideo.pause();
  var dur=refVideo.duration||0;
  var times=dur?[dur*0.25,dur*0.5,dur*0.75]:[0.5];
  var cv=document.createElement("canvas"); cv.width=144; cv.height=Math.max(80,Math.round(144*(refVideo.videoHeight||9)/Math.max(1,refVideo.videoWidth||16)));
  var cx=cv.getContext("2d",{willReadFrequently:true});
  var totals={top:0,mid:0,bot:0}, colourVotes={};
  var chain=Promise.resolve();
  times.forEach(function(t){
    chain=chain.then(function(){ return seekRef(t); }).then(function(){
      cx.drawImage(refVideo,0,0,cv.width,cv.height);
      var bands=analyseFrame(cx,cv.width,cv.height); if(!bands) return;
      ["top","mid","bot"].forEach(function(name){
        totals[name]+=bands[name].n;
        var tc=topColour(bands[name]);
        if(tc){ colourVotes[tc.hex]=(colourVotes[tc.hex]||0)+tc.n; }
      });
    });
  });
  chain.then(function(){
    var bestHex=null,bestN=0;
    for(var hx in colourVotes){ if(colourVotes[hx]>bestN){ bestN=colourVotes[hx]; bestHex=hx; } }
    if(!bestHex){
      $("refStatus").textContent="Couldn't spot caption colours in those frames. The captions may be too small or the frames too dark. Use “Pick it by hand” below: pause on a captioned frame, freeze it, and tap a caption word.";
      return;
    }
    var pos="pos-bottom", posLabel="Bottom";
    if(totals.mid>totals.bot && totals.mid>totals.top){ pos="pos-centre"; posLabel="Centre"; }
    else if(totals.top>totals.bot*1.6){ pos="pos-centre"; posLabel="Centre / upper"; }
    else if(totals.bot<totals.mid*0.7){ pos="pos-third"; posLabel="Lower third"; }
    var distinct=Object.keys(colourVotes).length;
    var style="st-highlight", styleLabel="Highlight";
    var pr=parseInt(bestHex.slice(1,3),16), pg=parseInt(bestHex.slice(3,5),16), pb=parseInt(bestHex.slice(5,7),16);
    if(distinct>=3){ style="st-cycle"; styleLabel="Colour Cycle (many colours found)"; }
    else if(pr>225&&pg>225&&pb>225){ style="st-classic"; styleLabel="Classic (white captions)"; }
    refDetected={hex:bestHex,pos:pos,style:style};
    $("refSwatch").style.background=bestHex;
    $("refHex").textContent=bestHex;
    $("refPos").textContent=posLabel;
    $("refStyleName").textContent=styleLabel;
    $("refResult").classList.remove("hidden");
    $("refStatus").textContent="Found a look. Tap “Apply this look” to use it. You can still adjust colour, position and style by hand in section 3.";
    if(wasPaused===false) refVideo.play().catch(function(){});
  });
});
$("refApplyBtn").addEventListener("click",function(){
  if(!refDetected) return;
  capColor=refDetected.hex; $("colorInput").value=refDetected.hex;
  setPos(refDetected.pos);
  setStyle(refDetected.style);
  $("refStatus").textContent="Applied: colour "+refDetected.hex+", position and style set. Play your video to see it. Tweak anything in section 3.";
  document.querySelector('section[aria-label="Caption style"]').scrollIntoView({behavior:"smooth"});
});
$("refFreezeBtn").addEventListener("click",function(){
  if(!refVideo.src){ $("refPickStatus").textContent="Load a reference video first."; return; }
  var cv=$("refCanvas");
  var vw=refVideo.videoWidth||320, vh=refVideo.videoHeight||180;
  var scale=Math.min(1,340/vw);
  cv.width=Math.round(vw*scale); cv.height=Math.round(vh*scale);
  cv.getContext("2d").drawImage(refVideo,0,0,cv.width,cv.height);
  cv.classList.remove("hidden");
  $("refPickStatus").textContent="Frozen. Now tap right on a caption word in the picture above.";
});
$("refCanvas").addEventListener("click",function(e){
  var cv=$("refCanvas"), rect=cv.getBoundingClientRect();
  var x=Math.floor((e.clientX-rect.left)*(cv.width/rect.width));
  var y=Math.floor((e.clientY-rect.top)*(cv.height/rect.height));
  var d;
  try{ d=cv.getContext("2d",{willReadFrequently:true}).getImageData(x,y,1,1).data; }catch(err){ $("refPickStatus").textContent="Couldn't read that pixel. Try another spot."; return; }
  var hex=rgbHex(d[0],d[1],d[2]);
  capColor=hex; $("colorInput").value=hex; drawOverlay();
  $("refPickStatus").textContent="Picked "+hex+". Set as your accent colour. Try Pop, Bounce or Karaoke in section 3 to use it.";
});

/* ---------- AI clean-up (BYOK, text only) ---------- */
var aiIds=["aiEndpoint","aiModel","aiKey"];
aiIds.forEach(function(id){ var v=""; try{v=localStorage.getItem("cl_"+id)||""}catch(e){} if(v) $(id).value=v;
  $(id).addEventListener("change",function(){ try{localStorage.setItem("cl_"+id,this.value)}catch(e){} }); });
function aiCall(instruction,done){
  var ep=$("aiEndpoint").value.trim(), model=$("aiModel").value.trim(), key=$("aiKey").value.trim();
  if(!ep||!model||!key){ $("aiStatus").textContent="Fill in the endpoint, model and your API key first."; return; }
  if(!captions.length){ $("aiStatus").textContent="There are no captions to work on yet."; return; }
  $("aiStatus").textContent="Sending caption text only (never audio or video)…";
  var texts=captions.map(function(c){return c.text});
  fetch(ep,{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+key},
    body:JSON.stringify({model:model,temperature:0.2,messages:[
      {role:"system",content:"You edit short-video caption text. Reply with ONLY a JSON array of strings, same length and order as the input. No other text."},
      {role:"user",content:instruction+"\n\nCaptions JSON:\n"+JSON.stringify(texts)}]})})
  .then(function(r){ if(!r.ok) throw new Error("HTTP "+r.status); return r.json(); })
  .then(function(j){
    var out=j.choices&&j.choices[0]&&j.choices[0].message&&j.choices[0].message.content||"";
    var arr=JSON.parse(out.replace(/```json|```/g,"").trim());
    if(!Array.isArray(arr)||arr.length!==captions.length) throw new Error("bad shape");
    captions.forEach(function(c,i){ if(typeof arr[i]==="string"&&arr[i].trim()) c.text=arr[i].trim(); });
    renderCaps(); done();
  })
  .catch(function(e){ $("aiStatus").textContent="AI call failed ("+e.message+"). Check the endpoint, model and key. Your captions are unchanged."; });
}
$("aiCleanBtn").addEventListener("click",function(){
  aiCall("Fix punctuation, capitalisation and obvious misheard words in each caption. Keep the same language and roughly the same length. Do not add new information.",function(){ $("aiStatus").textContent="Captions cleaned up. Skim them once before exporting."; });
});
$("aiTranslateBtn").addEventListener("click",function(){
  var lang=$("aiLang").value; if(!lang){ $("aiStatus").textContent="Pick a language to translate into first."; return; }
  aiCall("Translate each caption into "+lang+". Keep it short and natural for subtitles, same order.",function(){ $("aiStatus").textContent="Captions translated to "+lang+"."; });
});
$("aiStyleBtn").addEventListener("click",function(){
  aiCall("Restyle each caption for short-form video: make it short, punchy and easy to read at a glance, ideally 2 to 5 words per caption, keeping the speaker's meaning and language. Keep strong, emotional words. Do not add hashtags or emojis.",function(){ $("aiStatus").textContent="Captions restyled: short and punchy. Check the timings still feel right, then export."; });
});
/* ---------- AI presets ---------- */
function setPreset(ep,model,msg){
  if(ep){ $("aiEndpoint").value=ep; try{localStorage.setItem("cl_aiEndpoint",ep)}catch(e){} }
  if(model){ $("aiModel").value=model; try{localStorage.setItem("cl_aiModel",model)}catch(e){} }
  $("aiStatus").textContent=msg;
}
$("presetMercury").addEventListener("click",function(){
  setPreset("https://api.inceptionlabs.ai/v1/chat/completions","mercury-3","Inception Mercury 3 preset set. Paste your Inception API key below. Endpoint and model stay editable if your plan names them differently.");
});
$("presetOpenAI").addEventListener("click",function(){
  setPreset("https://api.openai.com/v1/chat/completions","gpt-4o-mini","OpenAI preset set. Paste your OpenAI API key below.");
});
$("presetCustom").addEventListener("click",function(){
  $("aiStatus").textContent="Custom: type any OpenAI-compatible endpoint URL and model name in the fields below, then paste that provider's key.";
  $("aiEndpoint").focus();
});

renderCaps();
})();
</script>
