{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/((?!api(?:/|$)|_vercel/|robots\\.txt|sitemap\\.xml|llms\\.txt|assets/).*)", "destination": "/index.html" }
  ]
}
